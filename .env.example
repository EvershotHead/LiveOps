# ===== LLM 分析引擎（用户后续自行填写，留空时系统使用 Mock 模式）=====
# OpenAI 兼容接口，例如智谱: https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 强模型（复核路由用），留空时回落到 LLM_MODEL
LLM_STRONG_MODEL=

# ===== 嵌入模型 =====
# 可选: bge-m3 / BAAI/bge-small-zh-v1.5；不可用时自动降级到哈希嵌入并标记
EMBED_MODEL=BAAI/bge-m3
# HuggingFace 镜像（网络受限时取消注释）
# HF_ENDPOINT=https://hf-mirror.com

# ===== 运行模式 =====
# demo=公开只读演示（无密钥），local=本地完整模式
LIVEOPS_MODE=local
